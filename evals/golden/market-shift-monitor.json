        "durability_score": 1.0
      },
      "assertions": [
        {
          "path": "shift_materiality",
          "approx": 89.5,
          "tol": 0.1
        },
        {
          "path": "shift_band",
          "equals": "structural"
        }
      ]
    },
    {
