# Copy to .env (read by `b2b-skills` when python-dotenv is installed).
# Only the block for the provider you use is needed.

PROVIDER=mock            # mock | claude-code | anthropic | openai

# --- PROVIDER=claude-code (no API key: uses your Claude Code login / subscription) ---
# CLAUDE_CODE_MODEL=sonnet            # or opus, haiku, or a full model ID
# CLAUDE_CODE_BIN=/path/to/claude     # if not on PATH

# --- PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5     # e.g. claude-sonnet-5-5 or claude-haiku-5-5 for lower cost
# ANTHROPIC_EFFORT=medium             # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=off             # disable server-side refusal fallbacks

# --- PROVIDER=openai ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- HTTP server (b2b-skills serve) ---
# B2B_SKILLS_API_TOKEN=               # required; generate with: openssl rand -hex 32
# B2B_SKILLS_MAX_BODY_BYTES=262144
